Screen { background: $background; color: $foreground; scrollbar-color: #375747; scrollbar-color-hover: #486b55; }
Button { min-width: 0; height: 3; padding: 0 1; }
Input, Select { background: $background; }
#bar, #compose-actions, #bottom-bar, .dialog-buttons { height: 3; }
#bar { background: $surface; padding: 0 1; }
#title { width: 1fr; height: 3; content-align: left middle; text-style: bold; color: $accent; }
#body { height: 1fr; }
#sidebar { width: 35; max-width: 38%; height: 1fr; background: $surface; border-right: solid #323a33; padding: 0 1; }
#sidebar Button { width: 100%; }
#btw-panel { width: 45; max-width: 41%; height: 1fr; border-left: solid #323a33; padding: 0 1; }
#btw-live { display: none; }
#btw-status { height: 1; padding: 0 3; color: #87ba9c; text-overflow: ellipsis; }
#btw-actions { height: 3; align-horizontal: right; }
#btw-actions Button { padding: 0 1; }
#slash-commands, #btw-commands { height: auto; max-height: 5; border: solid #466b53; background: $surface; }
#btw-commands { display: none; }
#tree { height: 1fr; background: $surface; }
#main { width: 1fr; height: 1fr; padding: 0 1; }
#thread-bar { height: 3; }
#thread-title, #btw-title { width: 1fr; height: 3; content-align: left middle; text-style: bold; }
.transcript-pane { height: 1fr; layers: default latest; }
Button.transcript-latest {
    display: none; layer: latest; dock: bottom; width: 5; height: 3; padding: 0;
    content-align: center middle;
    border: round #46574c; background: #141414 55%; color: #a9c4b0; text-style: none;
}
Button.transcript-latest:hover, Button.transcript-latest:focus, Button.transcript-latest.-active {
    border: round #708779; background: #1d2520 65%; color: #d0e0d4; text-style: none;
}
#history, #btw-history { height: 1fr; background: #141414; border: solid #323a33; padding: 0 1; }
#btw-history { overflow-x: hidden; }
.chat-message { width: 1fr; height: auto; color: #f2f2f2; text-style: none; padding: 1 2; margin-top: 1; }
.from-user { background: #292929; }
.from-codex { background: #141414; }
.tool-block, .tool-block:focus-within { height: auto; border: none; background: #141414; background-tint: transparent; padding: 0 2; }
.tool-title { width: 1fr; height: 1; color: #b7b9bd; text-style: none; text-wrap: nowrap; text-overflow: ellipsis; pointer: pointer; padding: 0 1; }
.tool-title:hover, .tool-title:focus { background: #343434; color: #dfdfdf; text-style: none; }
.tool-detail { color: #b7b9bd; text-style: none; padding: 0 0 1 3; }
#live, #btw-live { height: auto; max-height: 8; padding: 0 3; color: #f2f2f2; text-style: none; }
#activity { height: 1; padding: 0 3; color: #87ba9c; }
#attachments { height: auto; max-height: 2; color: $accent; }
#prompt, #btw-input { height: 5; border: solid #323a33; }
#compose-hint { width: 1fr; min-width: 0; height: 3; content-align: left middle; color: #a6ada6; text-wrap: nowrap; text-overflow: ellipsis; }
#compose-actions Button { padding: 0; }
#status { height: 1; padding: 0 1; color: #a6ada6; }
#bottom-bar { background: $surface; padding: 0 1; }
#usage-line { width: 1fr; min-width: 0; height: 3; padding: 0 1; content-align: left middle; color: $accent; text-wrap: nowrap; text-overflow: ellipsis; }
#model-picker, #effort-picker { color: $accent; }
ModalScreen { align: center middle; background: #121412 75%; }
.dialog { width: 72; max-width: 95%; height: auto; max-height: 90%; padding: 1 2; background: $surface; border: solid #466b53; }
.dialog-body { height: auto; max-height: 14; margin: 1 0; }
.dialog-buttons { align-horizontal: right; }
Picker { align: right bottom; padding: 0 1 3 0; }
Picker .dialog { width: 48; max-height: 90%; }
#picker-options { height: auto; max-height: 13; }
#path-error { color: #f38ba8; }
.question-page { height: auto; }
.question-page Static { margin-bottom: 1; }
.answer-choice { width: 100%; }
#question-error { color: #f38ba8; }
